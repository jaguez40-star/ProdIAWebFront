marimo/_lsp/
__marimo__/
# CLAUDE.md SI se versiona: es la guia de trabajo del proyecto.

# === ProdIA — exclusiones específicas del proyecto ===

# Bases de datos (fuentes de verdad — no versionar)
data/*.db
data/*.zip
data/*.sql
data/DB dump/
# ...también en subcarpetas (data/*.db NO cubre data/<carpeta>/x.db).
# Caso real: data/ECP_DIFERIDAS/ECP_DIFERIDAS.db pesa 954 MB.
data/**/*.db
# Journals/WAL de SQLite (transitorios; pueden pesar cientos de MB — p.ej. ECP_DIFERIDAS_slim.db-journal 192 MB).
data/**/*.db-journal
data/**/*.db-wal
data/**/*.db-shm
# Las migraciones SQL de esas BD SÍ se versionan (son el "cómo se arregló").
!data/**/migrations/*.sql

# Corpus de reportes diarios (.xlsm de ~34 MB c/u; una tanda = ~1,5 GB).
# GitHub rechaza >100 MB por archivo y el historial es permanente: una vez
# dentro, sacarlos exige reescribir la historia. Los .xlsm se mueven al
# servidor por copia directa, no por git (a diferencia de Eventos_OW.xlsx,
# 259 KB, que SÍ se versiona a propósito).
data/**/*.xlsm

# Directorios de datos generados/cargados
data/exports/
data/uploads/
data/logs/

# Base vectorial ChromaDB (regenerable con scripts/refresh_vector_db.py)
vector_db/

# Sesiones Flask
flask_session/

# Archivos temporales y backups
temp_*.txt
temp_*.py
*.bak
*[- ]Copy.py
*[- ]Copy.db
*[- ]Copy.zip

# Sub-proyecto INGESTA: datos pesados (.xlsm ~464 MB) y entornos
INGESTA/Rep_Prod/data/
# Backups de la BD (dumps .sql/.dump multi-GB — NUNCA versionar)
INGESTA/Rep_Prod/db/backups/
INGESTA/Rep_Prod/backend/.venv/
INGESTA/Rep_Prod/frontend/node_modules/
INGESTA/Rep_Prod/frontend/dist/
INGESTA/Rep_Prod/.env

# Herramientas IA locales (no relevantes para el repo)
.claude/
.codex/

# Imágenes ad-hoc en raíz
image.png

# Archivo de diferidas (dato operacional, no código)
DIFERIDAS_MES.csv
