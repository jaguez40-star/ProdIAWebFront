# ============================================================
# ProdIA (ECP Insights Flask) — Plantilla de variables de entorno
# ------------------------------------------------------------
# Copia este archivo a ".env" y rellena los valores reales.
# El ".env" real NO se versiona (está en .gitignore).
#
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows CMD)
# ============================================================

# ------------------------------------------------------------
# Base de datos legacy (Azure Synapse / DataGenesis, SQL Server)
# ------------------------------------------------------------
DB_HOST="<host>.sql.azuresynapse.net"
DB_PORT="1433"
DB_NAME="<nombre_bd>"
DB_USER="<usuario>"
DB_PASSWORD="<contraseña>"

# ------------------------------------------------------------
# OpenAI (LLM de respaldo) — opcional si solo se usa Ollama
# ------------------------------------------------------------
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------
# Ollama (LLM local) — opcional
# ------------------------------------------------------------
OLLAMA_MODEL="gemma4:latest"
# OLLAMA_BASE_URL="http://localhost:11434"

# ------------------------------------------------------------
# Flask
# ------------------------------------------------------------
# SECRET_KEY="<cadena-aleatoria-larga>"
# FLASK_DEBUG="False"
# FLASK_ENV="production"

# ------------------------------------------------------------
# SSO Launcher: endpoint /api/auth/verify
#   DEV: puerto 5010  |  PROD: puerto 5001
# ------------------------------------------------------------
LAUNCHER_VERIFY_URL=http://10.100.26.139:5010/api/auth/verify

# ------------------------------------------------------------
# Servicio de INGESTA (FastAPI). Si corre en la misma máquina,
# dejar el default. Solo cambiar si está en otro host/puerto.
# ------------------------------------------------------------
# INGESTA_API_URL=http://localhost:5030

# ============================================================
# AUTENTICACIÓN POR ENTORNO  (¡IMPORTANTE PARA SEGURIDAD!)
# ------------------------------------------------------------
# DESARROLLO: descomenta para saltar LDAP y/o permitir bypass.
# PRODUCCIÓN: DEJA ESTAS DOS SIN DEFINIR (o vacías) => LDAP
#             activo y sin bypass (seguro por defecto).
# ============================================================
# Salta verificación DNS/LDAP (mantiene la validación de lista blanca)
# DEVELOPMENT_MODE=true
# Correos que entran SIN LDAP ni lista blanca (separados por coma)
# LOGIN_BYPASS_EMAILS=usuario.dev@ecopetrol.com.co
